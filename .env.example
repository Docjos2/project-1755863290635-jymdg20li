# Supabase Configuration (Required for Authentication & Data Persistence)
# Get your project URL and anon key from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic API Key (Optional)
# Get your API key from: https://console.anthropic.com/
# If not set, users will be prompted to enter their key in the app
VITE_ANTHROPIC_API_KEY=

# Example:
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
# VITE_ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
